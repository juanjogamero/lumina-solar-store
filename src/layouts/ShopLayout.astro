---
import '../styles/shop.css';
const { title = 'UnEspacio | Iluminación para transformar tus espacios', description = 'Ideas de iluminación exterior seleccionadas con criterio. Descubre UnEspacio y conoce qué comprobar antes de elegir tu próxima luz solar.' } = Astro.props;
const pathBase = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="es">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<meta name="theme-color" content="#f8f6f0"/>
<meta name="description" content={description}/>
<meta name="robots" content="index,follow"/>
<meta property="og:type" content="website"/>
<meta property="og:title" content={title}/>
<meta property="og:description" content={description}/>
<link rel="icon" type="image/png" href={pathBase + 'IDENTIDAD/isonegro.png'}/>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
<title>{title}</title>
</head>
<body><slot/></body>
</html>