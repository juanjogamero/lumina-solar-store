---
import ShopLayout from '../layouts/ShopLayout.astro';
import {store, featuredProduct as product, verifiedReviews} from '../data/store';
const canCheckout = Boolean(product.available && product.stockConfirmed && store.checkoutConfigured && product.checkoutUrl && product.priceEur !== null);
const amount = product.priceEur === null ? 'Precio por confirmar' : new Intl.NumberFormat('es-ES',{style:'currency',currency:'EUR'}).format(product.priceEur);
const usage = [
  {category:'EL PRIMER IMPACTO',name:'Entradas con personalidad',image:'https://images.unsplash.com/photo-1600566753190-17f0baa2a6c3?auto=format&fit=crop&w=1000&q=85'},
  {category:'NOCHES TRANQUILAS',name:'Terrazas más acogedoras',image:'https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=1000&q=85'},
  {category:'PEQUEÑOS DETALLES',name:'Rincones exteriores',image:'https://images.unsplash.com/photo-1600566753086-00f18fb6b3ea?auto=format&fit=crop&w=1000&q=85'},
];
const faqs = [
 {q:'¿Hay que instalar cables eléctricos?',a:'Una lámpara solar autónoma puede funcionar sin llevar cable de alimentación al punto de instalación. El método exacto y los accesorios dependen del modelo que finalmente se comercialice.'},
 {q:'¿Cuánto tiempo permanece encendida?',a:'La autonomía depende de la batería, exposición solar, modo de funcionamiento y estación del año. Todavía no se han confirmado los datos técnicos de un modelo de proveedor.'},
 {q:'¿Resiste la lluvia?',a:'Antes de comercializarla, comprobaremos la clasificación IP oficial del fabricante y las condiciones de instalación. No anunciamos una resistencia concreta sin esa ficha técnica.'},
 {q:'¿Cómo se carga?',a:'En los modelos solares, el panel obtiene energía de la luz solar. La ubicación y las condiciones ambientales influyen en la carga.'},
 {q:'¿Cuándo estará disponible para comprar?',a:'La tienda aún está preparando catálogo, precio final, proveedor y pasarela de pago. No se aceptan pedidos hasta verificar esas condiciones.'},
 {q:'¿Cómo funcionan los envíos y devoluciones?',a:'Los plazos, costes y condiciones comerciales se publicarán cuando se confirme el proveedor y el operador de transporte, y antes de habilitar cualquier cobro.'},
];
---
<ShopLayout title="UnEspacio — Iluminación solar exterior | Descubre otra forma de vivir tu hogar">
  <div class="announcement">{store.announcement}</div>
  <header class="topbar">
    <div class="container">
      <a href="#inicio" class="brand" aria-label="UnEspacio, ir al inicio">Un<span>Espacio.</span></a>
      <nav id="main-nav" class="main-nav" aria-label="Navegación principal">
        <a href="#beneficios">Beneficios</a><a href="#producto">El producto</a><a href="#inspiracion">Inspiración</a><a href="#opiniones">Opiniones</a><a href="#preguntas">Preguntas frecuentes</a>
      </nav>
      <div class="nav-actions"><a class="nav-cta" href="#producto">Descubrir el producto ↗</a><button id="toggle-nav" class="menu-btn" type="button" aria-label="Abrir navegación" aria-expanded="false" aria-controls="main-nav">☰</button></div>
    </div>
  </header>
  <main>
    <section class="hero" id="inicio">
      <div class="container hero-grid">
        <div class="hero-content">
          <span class="kicker">Hogar con intención</span>
          <h1>Que tu exterior <em>brille con estilo.</em></h1>
          <p class="hero-desc">La iluminación transforma cómo vives una terraza, una entrada o un pequeño patio. Descubre una forma más acogedora de disfrutar los espacios que te rodean.</p>
          <div class="hero-actions"><a class="btn btn-dark" href="#producto">Descubre la luz solar <span aria-hidden="true">↗</span></a><a class="btn btn-light" href="#beneficios">Conocer ventajas ↓</a></div>
          <div class="hero-note">Una selección en preparación. Imágenes de ambientación ilustrativas; el producto definitivo y sus características aún deben confirmarse.</div>
        </div>
        <div class="hero-image"><img src={product.image} alt="Inspiración de interiorismo para crear ambientes cálidos, fotografía ilustrativa" fetchpriority="high"/><span class="hero-photo-label">UnEspacio · Inspiración para el hogar</span></div>
      </div>
    </section>
    <div class="benefit-strip"><div class="container strip-grid"><div class="strip-item"><span class="strip-icon">◌</span><span>Un hogar con más personalidad</span></div><div class="strip-item"><span class="strip-icon">✧</span><span>Ideas sencillas para renovar ambientes</span></div><div class="strip-item"><span class="strip-icon">⌂</span><span>Diseño para espacios cotidianos</span></div></div></div>
    <section class="section" id="beneficios">
      <div class="container"><div class="section-heading"><span class="kicker">Lo que cambia el ambiente</span><h2>Más que una luz.<br/>Otra forma de vivir fuera.</h2><p>Las ventajas que hacen atractiva la iluminación solar exterior, sujetas a elegir el modelo adecuado para cada instalación.</p></div>
        <div class="benefit-grid">{product.benefits.map((item,i)=><article class="benefit-card"><span class="benefit-index">{String(i+1).padStart(2,'0')} / VENTAJA</span><h3>{item.heading}</h3><p>{item.description}</p></article>)}</div>
      </div>
    </section>
    <section class="section product-section" id="producto">
      <div class="container product-grid">
        <div class="product-gallery"><div class="product-main-image"><img src={product.gallery[0]} loading="lazy" alt="Imagen ambiental ilustrativa de una vivienda"/><span class="photo-hint">Fotografía de ambientación · No es fotografía de producto</span></div><div class="product-mini"><img src={product.gallery[1]} loading="lazy" alt="Referencia de ambientación de hogar"/></div><div class="product-mini"><img src={product.gallery[2]} loading="lazy" alt="Otra propuesta de ambientación"/></div></div>
        <div class="product-desc"><span class="kicker">{product.category}</span><h2>{product.name}</h2><p>{product.tagline} Una propuesta pensada para explorar posibilidades de iluminación exterior, antes de elegir el modelo técnico final.</p>
        <div class="product-features"><div><span class="check">✓</span> Iluminación de ambiente para zonas exteriores</div><div><span class="check">✓</span> Concepto de instalación sin conexión eléctrica en el punto de luz</div><div><span class="check">✓</span> Diseño orientado a entradas, terrazas y patios</div></div>
        <div class="availability"><strong>{canCheckout ? amount : 'Producto en preparación · '+amount}</strong><span>{canCheckout?'Compra mediante pasarela externa configurada.':'Estamos verificando proveedor, especificaciones, precio final y disponibilidad. Sin pedidos ni cobros activos.'}</span></div>
        {canCheckout ? <a class="btn btn-dark product-btn" href={product.checkoutUrl!} rel="noopener noreferrer">Comprar ahora de forma segura ↗</a> : <button type="button" class="btn disabled-btn product-btn" disabled aria-disabled="true">Compra todavía no disponible</button>}
        <p class="product-smallprint">No se anuncian descuentos, existencias, reseñas ni condiciones de envío no verificadas.</p>
        </div>
      </div>
    </section>
    <section class="section"><div class="container story-grid"><div class="story-media"><img src="https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=1400&q=85" alt="Ejemplo de estancia residencial con iluminación ambiental" loading="lazy"/></div><div class="story-body"><span class="kicker">Una elección más consciente</span><h2>Un detalle que cambia cómo se siente un lugar.</h2><p>Antes de elegir una luz exterior, hay algunas preguntas que marcan la diferencia. Te ayudamos a descubrirlas para que el resultado encaje con tu espacio.</p><ol class="steps"><li><b>01</b><span>Elige dónde quieres crear ambiente.</span></li><li><b>02</b><span>Comprueba horas de sol, orientación y sombras.</span></li><li><b>03</b><span>Revisa la autonomía, resistencia IP y montaje del modelo.</span></li><li><b>04</b><span>Confirma el tamaño, la luz y las condiciones de compra.</span></li></ol></div></div></section>
    <section class="section use-section" id="inspiracion"><div class="container"><div class="section-heading"><span class="kicker">Inspírate</span><h2>Pequeños espacios.<br/>Grandes sensaciones.</h2><p>Así puede integrarse la iluminación en diferentes ambientes. Todas las imágenes son referencias visuales, no instalaciones nuestras.</p></div><div class="usage-grid">{usage.map(item=><article class="usage"><img src={item.image} alt={item.name+' — imagen de referencia'} loading="lazy"/><div><span>{item.category}</span><h3>{item.name}</h3></div></article>)}</div></div></section>
    <section class="section review-section" id="opiniones"><div class="container"><div class="section-heading"><span class="kicker">Confianza real</span><h2>Opiniones que se pueden comprobar.</h2><p>Cuando publiquemos experiencias de compradores, estarán basadas en reseñas auténticas y verificables, no en testimonios inventados.</p></div>
    {verifiedReviews.length > 0 ? <div class="verified-reviews">{verifiedReviews.map(r=><article class="review-card"><strong>{r.author} · {'★'.repeat(r.rating)}</strong><p>{r.text}</p><small>{r.date} · Fuente: {r.source}</small></article>)}</div> : <div class="review-shell"><h3>Aún no hay valoraciones verificadas.</h3><p>Preferimos mostrarte experiencias auténticas cuando existan, antes que rellenar la web con estrellas y nombres de clientes ficticios.</p></div>}
    </div></section>
    <section class="section faq-section" id="preguntas"><div class="container"><div class="section-heading"><span class="kicker">Resolvemos tus dudas</span><h2>Lo importante, claro.</h2><p>Respuestas transparentes antes de tomar una decisión de compra.</p></div><div class="faq-list">{faqs.map((f,i)=><details open={i===0}><summary>{f.q}</summary><p>{f.a}</p></details>)}</div></div></section>
    <section class="last-cta"><div class="container"><span class="kicker" style="color:#e0b98f">UnEspacio</span><h2>Los espacios importan.</h2><p>Estamos preparando una selección de productos y verificando las condiciones para que la tienda pueda abrir de forma responsable.</p><a href="#producto" class="btn">Volver al producto ↑</a></div></section>
  </main>
  <footer class="footer"><div class="container"><div class="footer-grid"><div><a class="brand" href="#inicio">Un<span>Espacio.</span></a><p>Iluminación, diseño y pequeños cambios que transforman el hogar. Proyecto de tienda en preparación: sin ventas activadas.</p></div><div><h4>Explora</h4><div class="footer-links"><a href="#beneficios">Ventajas</a><a href="#producto">El producto</a><a href="#inspiracion">Inspiración</a><a href="#preguntas">Preguntas frecuentes</a></div></div><div><h4>Información comercial</h4><div class="footer-links"><span>Identidad del vendedor pendiente de publicar</span><span>Envíos y devoluciones pendientes de confirmar</span><span>Pasarela de pago aún no configurada</span></div></div></div><div class="footer-bottom"><span>© {new Date().getFullYear()} UnEspacio · Sitio web en preparación</span><span>No se aceptan pagos ni pedidos desde esta versión.</span></div></div></footer>
  <script>
    const toggle = document.querySelector<HTMLButtonElement>('#toggle-nav');
    const nav = document.querySelector<HTMLElement>('#main-nav');
    toggle?.addEventListener('click',()=>{const next=toggle.getAttribute('aria-expanded')!=='true';toggle.setAttribute('aria-expanded',String(next));nav?.classList.toggle('open',next);});
    nav?.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{nav.classList.remove('open');toggle?.setAttribute('aria-expanded','false');}));
  </script>
</ShopLayout>