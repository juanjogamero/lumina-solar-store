const pics=Array.from(document.querySelectorAll('.thumbnail img')).map(el=>el.src);
const amounts={1:39.90,2:69.90,3:94.90};
let chosen=1,quantity=1,cart=[];
const el=id=>document.getElementById(id);
const money=n=>new Intl.NumberFormat('es-ES',{style:'currency',currency:'EUR'}).format(n);
try{const previous=JSON.parse(localStorage.getItem('unespacio-cart-demo')||'[]');if(Array.isArray(previous))cart=previous.filter(item=>[1,2,3].includes(item.pack)&&Number.isInteger(item.qty)&&item.qty>=1&&item.qty<=20)}catch{}
function render(){
 el('price').textContent=money(amounts[chosen]);el('mobilePrice').textContent=money(amounts[chosen]);el('quantity').textContent=quantity;
 document.querySelectorAll('[data-pack]').forEach(b=>b.setAttribute('aria-pressed',String(Number(b.dataset.pack)===chosen)));
 el('cartCount').textContent=cart.reduce((n,item)=>n+item.qty,0);
 el('subtotal').textContent=money(cart.reduce((n,item)=>n+amounts[item.pack]*item.qty,0));
 const body=el('cartBody');body.replaceChildren();
 if(!cart.length){const p=document.createElement('p');p.className='fine';p.textContent='Carrito demostrativo vacío.';body.append(p)}
 cart.forEach(item=>{const row=document.createElement('div');row.className='drawer-item';const pic=document.createElement('img');pic.src=pics[0];pic.alt='Fotografía de ambiente ilustrativa';const text=document.createElement('div');const title=document.createElement('strong');title.textContent='Pack de '+item.pack+' unidad'+(item.pack>1?'es':'');const detail=document.createElement('p');detail.className='fine';detail.textContent=item.qty+' pack(s) · '+money(item.qty*amounts[item.pack]);text.append(title,detail);row.append(pic,text);body.append(row)});
 try{localStorage.setItem('unespacio-cart-demo',JSON.stringify(cart))}catch{}
}
document.querySelectorAll('[data-image]').forEach(button=>button.addEventListener('click',()=>{const index=Number(button.dataset.image);el('mainPhoto').src=pics[index];document.querySelectorAll('[data-image]').forEach(b=>{b.classList.toggle('selected',b===button);b.setAttribute('aria-pressed',String(b===button))})}));
document.querySelectorAll('[data-pack]').forEach(b=>b.addEventListener('click',()=>{chosen=Number(b.dataset.pack);render()}));
el('minus').addEventListener('click',()=>{quantity=Math.max(1,quantity-1);render()});el('plus').addEventListener('click',()=>{quantity=Math.min(20,quantity+1);render()});
function toggle(open){el('drawer').classList.toggle('open',open);el('shade').classList.toggle('open',open);document.body.style.overflow=open?'hidden':'';if(open)el('close').focus()}
function add(){const item=cart.find(x=>x.pack===chosen);if(item)item.qty=Math.min(20,item.qty+quantity);else cart.push({pack:chosen,qty:quantity});render();toggle(true)}
el('addCart').addEventListener('click',add);el('previewCart').addEventListener('click',add);
el('openCart').addEventListener('click',()=>toggle(true));el('close').addEventListener('click',()=>toggle(false));el('shade').addEventListener('click',()=>toggle(false));el('clear').addEventListener('click',()=>{cart=[];render()});document.addEventListener('keydown',e=>{if(e.key==='Escape')toggle(false)});
el('menuButton').addEventListener('click',()=>{const on=el('mobileLinks').classList.toggle('open');el('menuButton').setAttribute('aria-expanded',String(on))});
el('mobileLinks').querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{el('mobileLinks').classList.remove('open');el('menuButton').setAttribute('aria-expanded','false')}));
render();
</script></body></html>